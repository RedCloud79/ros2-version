<?xml version="1.0"?>
<package format="3">
  <name>irop_pose_publisher</name>
  <version>0.0.1</version>

  <description>
    Publishes the IROP robot pose relative to the map frame using TF.
  </description>

  <maintainer email="leo@irop.co.kr">irop</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>

  <depend>tf2</depend>
  <depend>tf2_ros</depend>

  <depend>geometry_msgs</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>